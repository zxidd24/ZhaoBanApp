<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 读取：Android 12L(API 32) 及以下 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 读取：Android 13(API 33) 起按媒体类型细分，只申请图片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 读取：Android 14(API 34) 起支持"部分访问"，用于重新选择照片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Android 11(API 30) 起不再需要 WRITE_EXTERNAL_STORAGE，删除操作走 MediaStore 的 PendingIntent -->

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhaoBan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZhaoBan"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
